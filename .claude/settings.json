{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/ensure-deps.sh\"; [ -f \"$f\" ] && sh \"$f\"; exit 0",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/ensure-deps.sh\"; [ -f \"$f\" ] && sh \"$f\"; exit 0",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*--admin*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api graphql*mergePullRequest*)",
      "Bash(gh api graphql*BranchProtectionRule*)",
      "Bash(gh api graphql*epositoryRuleset*)",
      "Bash(*gh auth token*)"
    ]
  }
}
