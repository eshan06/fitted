# Every env var in ARCHITECTURE §17, without values. Values live on
# the Railway app service and in your local .env, which git ignores. Locally,
# `shopify app dev` supplies the first four, and DATABASE_URL points at the
# docker compose Postgres (README, Local development).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=
DATABASE_URL=
OPENAI_API_KEY=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=
