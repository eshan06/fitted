{%- comment -%}
  The size guide app block (ARCHITECTURE §9): next to the size picker on its
  product page, which a theme's quick view of the product brings along too, or
  in a featured product section, whose product the setting autofills. No
  Active chart, no output; loader.js applies the placement settings (§7).
{%- endcomment -%}
{%- assign p = block.settings.product -%}
{%- assign chart = p.metafields['$app'].chart.value -%}
{%- if chart -%}
  {%- assign place = 'featured' -%}
  {%- if template.name == 'product' and p.id == product.id -%}
    {%- assign place = 'main' -%}
  {%- endif -%}
  {%- render 'guide', p: p, chart: chart, id: block.id, place: place -%}
{%- endif -%}

{% schema %}
{
  "name": "Size guide",
  "target": "content",
  "javascript": "loader.js",
  "settings": [{ "type": "product", "id": "product", "label": "Product", "autofill": true }]
}
{% endschema %}
