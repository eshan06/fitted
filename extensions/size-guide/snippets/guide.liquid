{%- comment -%}
  One product's Size guide link and popup (ARCHITECTURE §9), for the app block
  and the app embed. p is the product, chart its chart, id makes the title's
  id unique on the page, and place says where it sits, for loader.js's
  placement checks (§7): main (its product page, or a theme's quick view of
  it), featured, tab (the floating tab) or after (after the merchant's CSS
  selector). loader.js shows the link once the chart validates; until then an
  inline style hides it from theme button rules. Liquid escapes every word.
  The error state links the store's Contact page when it has one. The
  merchant's label, header, icon, colors, font, direction and CSS (§7) reach
  the page only through guide-data's | json, and loader.js applies them as
  text and CSS values. The tab's styles come with it, after loader.js's, so
  they win over the link's and lose to custom CSS that starts .fitted-guide.
  The template holds Fitted's styles, css from app/lib/guide-css.ts (a test
  keeps the two equal), inert until loader.js adds them once, ahead of the
  merchant's CSS, so loader.js itself carries none.
  The chart and product ids are what guide.js's events name (§12). The theme
  editor gets none, so a merchant trying the guide adds no opens. Find my
  size's words come only on Pro, the one plan that shows it (§10). With
  "Show only the Find my size link" on (§7) and Find my size there to open,
  the link reads Find my size, and guide-data leaves out the label, which
  names the Size guide link; on other plans that setting changes nothing.
{%- endcomment -%}
{%- assign title_id = 'fitted-title-' | append: id -%}
{%- assign fit_only = false -%}
{%- if shop.metafields['$app'].plan.value == 'pro' and shop.metafields['$app'].settings.value.popup.fitOnly and chart.content.value.fit -%}
  {%- assign fit_only = true -%}
{%- endif -%}
<div
  class="fitted-guide"
  data-url="{{ 'guide.js' | asset_url }}"
  data-place="{{ place }}"
  {%- unless request.design_mode %}
  data-chart="gid://shopify/Metaobject/{{ chart.system.id | escape }}"
  data-product="gid://shopify/Product/{{ p.id | escape }}"
  {%- endunless %}
>
  {%- if place == 'tab' -%}
    <style>
      .fitted-tab{position:fixed;top:40%;right:0;z-index:2;flex-direction:column;gap:10px;min-width:44px;padding:16px 12px;border-radius:2px 0 0 2px;background:#161616;color:#fff;font-size:15px;letter-spacing:.04em;text-decoration:none;box-shadow:0 6px 18px rgba(22,22,22,.18);transform:translateY(-50%)}
      .fitted-tab:hover{background:#2448a8}
      .fitted-tab:focus-visible{outline:3px solid #2448a8;outline-offset:3px}
      .fitted-tab span{writing-mode:vertical-rl;transform:rotate(180deg)}
      .fitted-tab svg{width:22px;height:22px}
      @media (max-width:600px){.fitted-tab{width:44px;gap:8px;padding:14px 0;font-size:14px;box-shadow:0 6px 18px rgba(22,22,22,.2)}.fitted-tab svg{width:20px;height:20px}}
    </style>
  {%- endif -%}
  <button type="button" class="fitted-link{% if place == 'tab' %} fitted-tab{% endif %}" aria-haspopup="dialog" style="display:none !important">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 15.5 15.5 3l5.5 5.5L8.5 21z"/><path d="m7 12 2 2M10 9l2 2M13 6l2 2"/>
    </svg>
    <span>{%- if fit_only -%}{{- 'size_guide.fit' | t -}}{%- else -%}{{- 'size_guide.title' | t -}}{%- endif -%}</span>
  </button>
  <dialog class="fitted-dialog" aria-labelledby="{{ title_id }}">
    <div class="fitted-panel">
      <div class="fitted-head">
        <div>
          <h2 id="{{ title_id }}" class="fitted-title">{{ 'size_guide.title' | t }}</h2>
          <p class="fitted-sub">{{ p.title | escape }}</p>
        </div>
        <button type="button" class="fitted-x" aria-label="{{ 'size_guide.close' | t }}" data-fitted-close>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div
        class="fitted-body"
        data-t-chart="{{ 'size_guide.chart' | t }}"
        data-t-system="{{ 'size_guide.system' | t }}"
        data-t-units="{{ 'size_guide.units' | t }}"
        data-t-in="{{ 'size_guide.in' | t }}"
        data-t-cm="{{ 'size_guide.cm' | t }}"
        data-t-lb="{{ 'size_guide.lb' | t }}"
        data-t-kg="{{ 'size_guide.kg' | t }}"
        data-t-choose="{{ 'size_guide.choose' | t }}"
        data-t-selected="{{ 'size_guide.selected' | t }}"
        data-t-select="{{ 'size_guide.select' | t }}"
        data-t-sections="{{ 'size_guide.sections' | t }}"
        data-t-measure="{{ 'size_guide.measure' | t }}"
        data-t-line_first="{{ 'size_guide.line_first' | t }}"
        data-t-line="{{ 'size_guide.line' | t }}"
        data-t-drawing="{{ 'size_guide.drawing' | t }}"
        {%- if shop.metafields['$app'].plan.value == 'pro' %}
        data-t-fit="{{ 'size_guide.fit' | t }}"
        data-t-optional="{{ 'size_guide.optional' | t }}"
        data-t-no_tape="{{ 'size_guide.no_tape' | t }}"
        data-t-snug="{{ 'size_guide.snug' | t }}"
        data-t-regular="{{ 'size_guide.regular' | t }}"
        data-t-relaxed="{{ 'size_guide.relaxed' | t }}"
        data-t-recommend="{{ 'size_guide.recommend' | t }}"
        data-t-measured="{{ 'size_guide.measured' | t }}"
        data-t-eased="{{ 'size_guide.eased' | t }}"
        data-t-liked="{{ 'size_guide.liked' | t }}"
        data-t-stretched="{{ 'size_guide.stretched' | t }}"
        data-t-so="{{ 'size_guide.so' | t }}"
        data-t-why_in="{{ 'size_guide.why_in' | t }}"
        data-t-why_between="{{ 'size_guide.why_between' | t }}"
        data-t-why_large="{{ 'size_guide.why_large' | t }}"
        data-t-why_small="{{ 'size_guide.why_small' | t }}"
        data-t-why_usual="{{ 'size_guide.why_usual' | t }}"
        data-t-why_choice="{{ 'size_guide.why_choice' | t }}"
        data-t-no_fit="{{ 'size_guide.no_fit' | t }}"
        data-t-showing="{{ 'size_guide.showing' | t }}"
        data-t-tight="{{ 'size_guide.tight' | t }}"
        data-t-just_right="{{ 'size_guide.just_right' | t }}"
        data-t-loose="{{ 'size_guide.loose' | t }}"
        data-t-bar="{{ 'size_guide.bar' | t }}"
        data-t-others="{{ 'size_guide.others' | t }}"
        data-t-add="{{ 'size_guide.add' | t }}"
        data-t-privacy="{{ 'size_guide.privacy' | t }}"
        data-t-privacy_note="{{ 'size_guide.privacy_note' | t }}"
        data-t-fits_from="{{ 'size_guide.fits_from' | t }}"
        data-t-fits="{{ 'size_guide.fits' | t }}"
        {%- endif %}
      ></div>
    </div>
    <template data-state="loading">
      <p role="status" class="fitted-note">{{ 'size_guide.loading' | t }}</p>
      <div aria-hidden="true">
        {%- for row in (1..6) -%}
          <div class="fitted-skrow">{% for cell in (1..5) %}<span class="fitted-sk"></span>{% endfor %}</div>
        {%- endfor -%}
      </div>
    </template>
    <template data-state="error">
      <div role="alert" class="fitted-alert">
        <h3 class="fitted-h3">{{ 'size_guide.error' | t }}</h3>
        <p>{{ 'size_guide.error_text' | t }}</p>
        <div class="fitted-actions">
          <button type="button" class="fitted-btn" data-fitted-retry>{{ 'size_guide.retry' | t }}</button>
          <button type="button" class="fitted-btn fitted-ghost" data-fitted-close>{{ 'size_guide.dismiss' | t }}</button>
        </div>
        {%- if pages.contact.url -%}
          <p class="fitted-help">{{ 'size_guide.help' | t }} <a href="{{ pages.contact.url | escape }}">{{ pages.contact.title | escape }}</a>.</p>
        {%- endif -%}
      </div>
    </template>
  </dialog>
  <template data-fitted-css>.fitted-guide{--fitted-bg:#fff;--fitted-text:#161616;--fitted-accent:#2448a8}.fitted-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 2px;border:0;background:none;color:inherit;font:inherit;font-weight:600;text-decoration:underline;text-underline-offset:4px;cursor:pointer}.fitted-dialog{--fitted-muted:color-mix(in srgb,var(--fitted-text) 84%,var(--fitted-bg));--fitted-line:color-mix(in srgb,var(--fitted-text) 16%,var(--fitted-bg));--fitted-faint:color-mix(in srgb,var(--fitted-text) 10%,var(--fitted-bg));--fitted-tint:color-mix(in srgb,var(--fitted-accent) 10%,var(--fitted-bg));--fitted-alert:color-mix(in srgb,#d72c0d 8%,var(--fitted-bg));--fitted-alert-line:color-mix(in srgb,#d72c0d 40%,var(--fitted-bg));box-sizing:border-box;width:calc(100% - 32px);max-width:640px;max-height:calc(100% - 80px);margin:40px auto auto;padding:0;border:0;border-radius:0;background:var(--fitted-bg);color:var(--fitted-text);font-family:var(--fitted-font);box-shadow:0 24px 64px rgba(0,0,0,.28);overflow:auto;text-align:start;line-height:1.5}.fitted-dialog::backdrop{background:rgba(22,22,22,.55)}html:has(.fitted-dialog[open]){overflow:hidden}.fitted-dialog *{box-sizing:border-box}.fitted-dialog [hidden]{display:none!important}.fitted-dialog :focus-visible{outline:2px solid var(--fitted-accent);outline-offset:2px}.fitted-panel{display:flex;flex-direction:column;gap:18px;padding:28px 32px}.fitted-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.fitted-body{display:flex;flex-direction:column;gap:14px}.fitted-dialog .fitted-title{margin:0;font-size:28px;font-weight:600;letter-spacing:-.01em;line-height:1.2}.fitted-dialog .fitted-sub{margin:4px 0 0;font-size:15px;color:var(--fitted-muted)}.fitted-dialog .fitted-h3{margin:0;font-size:20px;font-weight:600;line-height:1.3}.fitted-dialog .fitted-note{margin:0;font-size:14px;color:var(--fitted-muted);white-space:pre-line}.fitted-dialog button{font:inherit;cursor:pointer}.fitted-dialog .fitted-x{display:inline-flex;flex:none;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid currentColor;border-radius:2px;background:var(--fitted-bg);color:inherit}.fitted-dialog .fitted-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border:1px solid var(--fitted-accent);border-radius:2px;background:var(--fitted-accent);color:var(--fitted-bg);font-size:15px;font-weight:600}.fitted-dialog .fitted-ghost{border-color:currentColor;background:var(--fitted-bg);color:inherit}.fitted-alert{display:flex;flex-direction:column;gap:14px;padding:18px;border:1px solid var(--fitted-alert-line);border-radius:2px;background:var(--fitted-alert)}.fitted-alert p{margin:0;font-size:15px;line-height:1.6}.fitted-actions{display:flex;flex-wrap:wrap;gap:12px}.fitted-alert .fitted-help{font-size:13px;line-height:1.5;color:var(--fitted-muted)}.fitted-help a{color:var(--fitted-accent);text-underline-offset:3px}.fitted-sk{display:block;height:12px;background:var(--fitted-faint)}.fitted-skrow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;padding:14px 12px;border-bottom:1px solid var(--fitted-faint)}@media (max-width:600px){.fitted-dialog{width:100%;max-width:none;max-height:92vh;max-height:92dvh;margin:auto 0 0;border-radius:14px 14px 0 0}.fitted-panel{gap:14px;padding:18px 16px}.fitted-actions{flex-direction:column;order:1}}</template>
  {%- render 'guide-data', chart: chart, p: p, fit_only: fit_only -%}
</div>
