// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Postgres on Railway, and locally from docker-compose.yml (ARCHITECTURE §14).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per shop (ARCHITECTURE §14): the plan cache (§8) and, from #26, the last full resolve (§6).
model Shop {
  shop          String    @id
  plan          String
  planCheckedAt DateTime?
  planOnStore   String?
  resolvedAt    DateTime?
}

// Import and resolve jobs (ARCHITECTURE §13, §14), run inside the app process.
model Job {
  id        String   @id
  shop      String
  kind      String // import, resolve
  status    String // running, done, failed
  progress  Json?
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, kind, createdAt])
  @@index([status, updatedAt])
}
